<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>StangaNetLib.Cryptography</AssemblyName>
    <RootNamespace>StangaNetLib.Cryptography</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Hashing, key derivation, HMAC, AES-GCM encryption, RSA digital signatures, and secure token generation. Depends on StangaNetLib.Core.</Description>
    <PackageTags>cryptography;hashing;hmac;aes-gcm;pbkdf2;hkdf;rsa;secure-token;stanganet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StangaNetLib.Cryptography.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StangaNetLib.Core" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\build\**" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <Target Name="StampBuildProps" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_BuildPropsFile>$(MSBuildThisFileDirectory)..\..\build\StangaNetLib.Cryptography.props</_BuildPropsFile>
    </PropertyGroup>
    <ItemGroup>
      <_BPLines Include="&lt;Project&gt;" />
      <_BPLines Include="  &lt;ItemGroup&gt;" />
      <_BPLines Include="    &lt;AssemblyAttribute Include=&quot;System.Reflection.AssemblyMetadataAttribute&quot;&gt;" />
      <_BPLines Include="      &lt;_Parameter1&gt;StangaNetLib.Cryptography&lt;/_Parameter1&gt;" />
      <_BPLines Include="      &lt;_Parameter2&gt;$(Version)&lt;/_Parameter2&gt;" />
      <_BPLines Include="    &lt;/AssemblyAttribute&gt;" />
      <_BPLines Include="  &lt;/ItemGroup&gt;" />
      <_BPLines Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(_BuildPropsFile)"
      Lines="@(_BPLines)"
      Overwrite="true"
      Encoding="UTF-8" />
    <Message Text="StangaNetLib.Cryptography: stamped build props with version $(Version)" Importance="high" />
  </Target>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\package-icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
